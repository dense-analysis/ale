  call mkdir(g:vcs_root_temp_dir . '/nested_same/outer/inner/src', 'p')
  call mkdir(g:vcs_root_temp_dir . '/nested_same/outer/.git')
  call mkdir(g:vcs_root_temp_dir . '/nested_same/outer/inner/.git')
  call writefile([], g:vcs_root_temp_dir . '/nested_same/outer/inner/src/file.toml')
  call ale#test#SetFilename(g:vcs_root_temp_dir . '/nested_same/outer/inner/src/file.toml')

  AssertEqual
  \ ale#path#Simplify(g:vcs_root_temp_dir . '/nested_same/outer/inner'),
  \ ale#path#FindVCSRoot(bufnr(''))

