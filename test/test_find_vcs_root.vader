Before:
  Save g:ale_vcs_root
  Save b:ale_vcs_root

  call ale#test#SetDirectory('/testplugin/test')

  let g:vcs_root_temp_dir = ale#path#Simplify(tempname())
  call mkdir(g:vcs_root_temp_dir, 'p')
  let g:ale_vcs_root = ['git', 'got', 'hg']

After:
  call ale#test#RestoreDirectory()
  call delete(g:vcs_root_temp_dir, 'rf')
  unlet! g:vcs_root_temp_dir

  Restore

Execute(FindVCSRoot should find a simple git directory):
  call mkdir(g:vcs_root_temp_dir . '/simple/project/src', 'p')
  call mkdir(g:vcs_root_temp_dir . '/simple/project/.git')
  call writefile([], g:vcs_root_temp_dir . '/simple/project/src/file.toml')
  call ale#test#SetFilename(g:vcs_root_temp_dir . '/simple/project/src/file.toml')

  AssertEqual
  \ ale#path#Simplify(g:vcs_root_temp_dir . '/simple/project'),
  \ ale#path#FindVCSRoot(bufnr(''))

Execute(FindVCSRoot should find git worktree files):
  call mkdir(g:vcs_root_temp_dir . '/with-worktree/project/src', 'p')
  call mkdir(g:vcs_root_temp_dir . '/with-worktree/project/.git')
  call mkdir(g:vcs_root_temp_dir . '/with-worktree/project/wt/src', 'p')
  call writefile([], g:vcs_root_temp_dir . '/with-worktree/project/wt/.git')
  call writefile([], g:vcs_root_temp_dir . '/with-worktree/project/wt/src/file.toml')
  call ale#test#SetFilename(g:vcs_root_temp_dir . '/with-worktree/project/wt/src/file.toml')

  AssertEqual
  \ ale#path#Simplify(g:vcs_root_temp_dir . '/with-worktree/project/wt'),
  \ ale#path#FindVCSRoot(bufnr(''))

