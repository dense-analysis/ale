Execute(FindVCSRoot should obey the global marker selector):
  let g:ale_vcs_root = ['git']

  call mkdir(g:vcs_root_temp_dir . '/global_selector/outer/inner/src', 'p')
  call mkdir(g:vcs_root_temp_dir . '/global_selector/outer/.git')
  call mkdir(g:vcs_root_temp_dir . '/global_selector/outer/inner/.hg')
  call writefile([], g:vcs_root_temp_dir . '/global_selector/outer/inner/src/file.toml')
  call ale#test#SetFilename(g:vcs_root_temp_dir . '/global_selector/outer/inner/src/file.toml')

  AssertEqual
  \ ale#path#Simplify(g:vcs_root_temp_dir . '/global_selector/outer'),
  \ ale#path#FindVCSRoot(bufnr(''))

Execute(FindVCSRoot should let buffer marker selectors override globals):
  let g:ale_vcs_root = ['git']
  let b:ale_vcs_root = ['hg']

  call mkdir(g:vcs_root_temp_dir . '/buffer_selector/outer/inner/src', 'p')
  call mkdir(g:vcs_root_temp_dir . '/buffer_selector/outer/.git')
  call mkdir(g:vcs_root_temp_dir . '/buffer_selector/outer/inner/.hg')
  call writefile([], g:vcs_root_temp_dir . '/buffer_selector/outer/inner/src/file.toml')
  call ale#test#SetFilename(g:vcs_root_temp_dir . '/buffer_selector/outer/inner/src/file.toml')

  AssertEqual
  \ ale#path#Simplify(g:vcs_root_temp_dir . '/buffer_selector/outer/inner'),
  \ ale#path#FindVCSRoot(bufnr(''))
